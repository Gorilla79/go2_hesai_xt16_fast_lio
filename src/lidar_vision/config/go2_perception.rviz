Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Cell Size: 0.5
      Line Style:
        Line Width: 0.03

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Axes: true
      Show Names: true
      Marker Scale: 0.4

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description

    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR Calibrated Cloud
      Enabled: true
      Topic:
        Value: /lidar_points_calibrated
      Size (Pixels): 2
      Style: Points
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true

    - Class: rviz_default_plugins/MarkerArray
      Name: Detected Persons
      Enabled: true
      Topic:
        Value: /detected_person_markers

    - Class: rviz_default_plugins/MarkerArray
      Name: Sensor Mounts
      Enabled: true
      Topic:
        Value: /sensor_mount_markers

    - Class: rviz_default_plugins/Image
      Name: RealSense RGB
      Enabled: true
      Topic:
        Value: /camera/color/image_raw
      Normalize Range: true

  Enabled: true
  Global Options:
    Fixed Frame: base_link
    Frame Rate: 30

  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.0
      Focal Point:
        X: 1.5
        Y: 0.0
        Z: 0.5
      Pitch: 0.7
      Yaw: 3.14

Window Geometry:
  Width: 1600
  Height: 900
